# Clinical Trial Decision Lab — credentials for LIVE provider runs only.
# Offline runs, tests, dry runs and the demo need none of these.
#
#   cp .env.example .env && chmod 600 .env
#
# .env is gitignored. Never commit it and never paste keys into chats or issues.
# Fill in only the providers you want to run. See configs/models.yaml for what each key is used for,
# and docs/DATA-LICENSING-AUDIT.md for what each provider's terms allow you to publish.

TYPESAFE_API_KEY=
OPENAI_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
ANTHROPIC_API_KEY=
PERPLEXITY_API_KEY=
MORPH_API_KEY=
OPPER_API_KEY=
RUNWARE_API_KEY=

# Self-hosted open-weight models served by a local Ollama instance, e.g. http://127.0.0.1:11434
OLLAMA_BASE_URL=

# Optional: folder holding datasets that are not distributed with this repository
# (the regulatory-finding track). Keep it outside this repository.
TRIALLAB_RESTRICTED_DATA=
